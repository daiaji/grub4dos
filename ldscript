/* Linker script to create grub .img files on Cygwin.  */

SECTIONS
{
  .text :
  {
    start = . ;
    *(.text)
    etext = . ;
  }
  .data :
  {
    __data_start__ = . ;
    *(.data)
    __data_end__ = . ;
  }
  .rdata :
  {
    __rdata_start__ = . ;
    *(.rdata)
    __rdata_end__ = . ;
  }
  .pdata :
  {
    *(.pdata)
  }
  .bss :
  {
    __bss_start__ = . ;
    *(.bss)
    __common_start__ = . ;
    *(COMMON)
    __bss_end__ = . ;
  }
  .edata :
  {
    *(.edata)
  }
  .stab :
  {
    *(.stab)
  }
  .stabstr :
  {
    *(.stabstr)
  }
}

ASSERT(!SIZEOF(.pdata), ".pdata not empty")
ASSERT(!SIZEOF(.edata), ".edata not empty")

/* Symbols grub4dos' runtime (asm.S) expects.  They must live OUTSIDE any
 * output section: with the mingw toolchain the empty .pdata/.edata sections
 * get discarded, and a symbol defined inside a discarded section fails the
 * link ("defined in discarded section").  edata/end therefore anchor on the
 * section markers of .pdata/.bss instead. */
edata = __bss_start__;
end = __bss_end__;

/* plain spellings used by asm.S when HAVE_ASM_USCORE is unset */
PROVIDE(__bss_start = __bss_start__);
PROVIDE(_edata = __bss_start__);
PROVIDE(end2 = __bss_end__);
PROVIDE(_end = __bss_end__);
